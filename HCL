{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"history_visible":true,"authorship_tag":"ABX9TyONrk0fpzmzvsd/zlhUIoHh"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["\n","import datetime\n","import math\n","\n","\n","class Vehicle:\n","    \"\"\"Represents a vehicle entering the parking lot.\"\"\"\n","\n","    def __init__(self, license_plate: str, vehicle_type: str, owner_name: str):\n","        self.license_plate = license_plate.upper()\n","        self.vehicle_type = vehicle_type.capitalize()\n","        self.owner_name = owner_name\n","        self.entry_time = None\n","\n","    def __str__(self):\n","        return f\"[{self.vehicle_type}] {self.license_plate} (Owner: {self.owner_name})\"\n","\n","\n","class ParkingSlot:\n","    \"\"\"Represents an individual parking slot.\"\"\"\n","\n","    def __init__(self, slot_id: str, slot_type: str):\n","        self.slot_id = slot_id\n","        self.slot_type = slot_type.capitalize()\n","        self.is_occupied = False\n","        self.parked_vehicle = None\n","\n","    def assign_vehicle(self, vehicle: Vehicle):\n","        self.parked_vehicle = vehicle\n","        self.is_occupied = True\n","\n","    def remove_vehicle(self):\n","        vehicle = self.parked_vehicle\n","        self.parked_vehicle = None\n","        self.is_occupied = False\n","        return vehicle\n","\n","\n","class ParkingLot:\n","    \"\"\"Manages parking slots, vehicle registration, and fee calculation.\"\"\"\n","\n","    HOURLY_RATES = {\n","        \"Bike\": 20,\n","        \"Car\": 50,\n","        \"Truck\": 100\n","    }\n","\n","    def __init__(self, name: str):\n","        self.name = name\n","        self.slots = []\n","\n","    def add_slot(self, slot_id: str, slot_type: str):\n","        self.slots.append(ParkingSlot(slot_id, slot_type))\n","\n","    def park_vehicle(self, vehicle: Vehicle) -> bool:\n","\n","        # Check if vehicle is already parked\n","        for slot in self.slots:\n","            if slot.is_occupied and slot.parked_vehicle.license_plate == vehicle.license_plate:\n","                print(f\"Error: Vehicle {vehicle.license_plate} is already parked in Slot {slot.slot_id}.\")\n","                return False\n","\n","        # Find first available matching slot\n","        for slot in self.slots:\n","            if not slot.is_occupied and slot.slot_type == vehicle.vehicle_type:\n","                vehicle.entry_time = datetime.datetime.now()\n","                slot.assign_vehicle(vehicle)\n","\n","                print(f\"Success: {vehicle} parked at Slot {slot.slot_id} at {vehicle.entry_time.strftime('%H:%M:%S')}.\")\n","                return True\n","\n","        print(f\"Sorry: No available '{vehicle.vehicle_type}' slots at the moment.\")\n","        return False\n","\n","    def calculate_charges(self, vehicle: Vehicle, exit_time: datetime.datetime) -> float:\n","\n","        duration = exit_time - vehicle.entry_time\n","        hours = math.ceil(duration.total_seconds() / 3600)\n","        hours = max(1, hours)\n","\n","        rate = self.HOURLY_RATES.get(vehicle.vehicle_type, 50)\n","\n","        return hours * rate\n","\n","    def release_vehicle(self, license_plate: str) -> bool:\n","\n","        license_plate = license_plate.upper()\n","\n","        for slot in self.slots:\n","            if slot.is_occupied and slot.parked_vehicle.license_plate == license_plate:\n","\n","                exit_time = datetime.datetime.now()\n","                vehicle = slot.remove_vehicle()\n","                fee = self.calculate_charges(vehicle, exit_time)\n","\n","                print(\"\\n--- PARKING RECEIPT ---\")\n","                print(f\"Slot Freed    : {slot.slot_id}\")\n","                print(f\"Vehicle       : {vehicle}\")\n","                print(f\"Entry Time    : {vehicle.entry_time.strftime('%Y-%m-%d %H:%M:%S')}\")\n","                print(f\"Exit Time     : {exit_time.strftime('%Y-%m-%d %H:%M:%S')}\")\n","                print(f\"Total Charge  : ₹{fee:.2f}\")\n","                print(\"-----------------------\\n\")\n","\n","                return True\n","\n","        print(f\"Error: Vehicle with plate '{license_plate}' not found in the parking lot.\")\n","        return False\n","\n","    def display_status(self):\n","        \"\"\"Displays current availability of all slots.\"\"\"\n","\n","        print(f\"\\n=== {self.name} - Slot Status ===\")\n","\n","        for slot in self.slots:\n","            status = f\"Occupied by {slot.parked_vehicle.license_plate}\" if slot.is_occupied else \"Available\"\n","            print(f\"Slot {slot.slot_id} ({slot.slot_type}): {status}\")\n","\n","        print(\"=====================================\\n\")\n","\n","\n","# Main Execution (Menu-Driven CLI)\n","\n","if __name__ == \"__main__\":\n","\n","    lot = ParkingLot(\"City Center Smart Parking\")\n","\n","    # Initialize sample slots\n","    lot.add_slot(\"B1\", \"Bike\")\n","    lot.add_slot(\"B2\", \"Bike\")\n","    lot.add_slot(\"C1\", \"Car\")\n","    lot.add_slot(\"C2\", \"Car\")\n","    lot.add_slot(\"T1\", \"Truck\")\n","\n","    while True:\n","\n","        print(\"1. Park Vehicle\")\n","        print(\"2. Release Vehicle\")\n","        print(\"3. View Slot Status\")\n","        print(\"4. Exit\")\n","\n","        choice = input(\"Enter choice (1-4): \").strip()\n","\n","        if choice == \"1\":\n","\n","            plate = input(\"Enter License Plate: \")\n","            v_type = input(\"Enter Vehicle Type (Bike/Car/Truck): \")\n","            owner = input(\"Enter Owner Name: \")\n","\n","            v = Vehicle(plate, v_type, owner)\n","            lot.park_vehicle(v)\n","\n","        elif choice == \"2\":\n","\n","            plate = input(\"Enter License Plate to release: \")\n","            lot.release_vehicle(plate)\n","\n","        elif choice == \"3\":\n","\n","            lot.display_status()\n","\n","        elif choice == \"4\":\n","\n","            print(\"Exiting system. Goodbye!\")\n","            break\n","\n","        else:\n","            print(\"Invalid choice. Please try again.\\n\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bPlf2D05aVKt","outputId":"cfa23a72-583c-4fa5-e34e-a44917f3d0a8"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["1. Park Vehicle\n","2. Release Vehicle\n","3. View Slot Status\n","4. Exit\n"]}]}]}